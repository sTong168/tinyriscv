# ========== 初始化 UART 为 TX 模式 ==========
000:  300007b7        lui     a5, 0x30000
004:  00100713        li      a4, 1
008:  00e7a023        sw      a4, 0(a5)

# ========== 设置阈值并复位 ==========
00c:  08000f93        addi    x31, x0, 128
010:  00000f13        addi    x30, x0, 0

# ========== IF 指令 + UART 发送 x30[7:0] ==========
014:  00af2f2f        IF      x30, x30, 0xa
018:  0fff7513        andi    a0, x30, 0xff
01c:  070000ef        jal     ra, 0x054         # -> uart_putc

020:  01af2f2f        IF      x30, x30, 0x1a
024:  0fff7513        andi    a0, x30, 0xff
028:  058000ef        jal     ra, 0x054

02c:  03af2f2f        IF      x30, x30, 0x3a
030:  0fff7513        andi    a0, x30, 0xff
034:  040000ef        jal     ra, 0x054

038:  02cf2f2f        IF      x30, x30, 0x2c
03c:  0fff7513        andi    a0, x30, 0xff
040:  028000ef        jal     ra, 0x054

044:  000f2f2f        IF      x30, x30, 0x0
048:  0fff7513        andi    a0, x30, 0xff
04c:  010000ef        jal     ra, 0x054

# 死循环
050:  0000006f        j       0x050

# ========== uart_putc 函数（原 0x274，现移至 0x054） ==========
054:  fe010113        addi    sp, sp, -32
058:  00812e23        sw      s0, 28(sp)
05c:  02010413        addi    s0, sp, 32
060:  00050793        mv      a5, a0
064:  fef407a3        sb      a5, -17(s0)
068:  00000013        nop
06c:  300007b7        lui     a5, 0x30000
070:  00478793        addi    a5, a5, 4
074:  0007a783        lw      a5, 0(a5)
078:  0017f793        andi    a5, a5, 1
07c:  fe0798e3        bnez    a5, 0x074        # 轮询等待 UART 空闲
080:  300007b7        lui     a5, 0x30000
084:  00c78793        addi    a5, a5, 12
088:  fef44703        lbu     a4, -17(s0)
08c:  00e7a023        sw      a4, 0(a5)
090:  00000013        nop
094:  01c12403        lw      s0, 28(sp)
098:  02010113        addi    sp, sp, 32
09c:  00008067        ret